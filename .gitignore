# =============================================================================
# llm-stack .gitignore
# Bảo mật tuyệt đối: Không bao giờ commit Secret, API Key, Token, DB hay Log
# =============================================================================

# 1. Environment variables & Secrets
.env
.env.*
*.env
!.env.example

# 2. Centralized Config & Credentials
config/*.csv
!config/*.csv.example
!config/cf_models.csv

config/*.json
!config/*.json.example

# Legacy secret paths (phòng ngừa rò rỉ)
NIM_accounts.csv
services/cf-ai-proxy/accounts.csv
services/claude-proxy/config.json

# 3. Runtime Data & Databases (SQLite, Redis, Backups)
data/
*.sqlite
*.sqlite3
*.db
*.tar.gz
*.bak

# 4. Logs & Scratch files
logs/
*.log
temp.md
scratch/
*.vtt

# 5. Build Artifacts & Binaries
services/cf-ai-proxy/cf-ai-proxy
services/claude-proxy/proxy
services/claude-proxy/claude-proxy
*.test
*.out

# 6. Operating System & IDE
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# 7. Submodules / Vendor
services/omniroute/
